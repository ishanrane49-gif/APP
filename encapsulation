class Student:
    def __init__(self, name, marks):
        self.name = name          
        self.__marks = marks      
        
    def set_marks(self, marks):
        self.__marks = marks

    def get_marks(self):
        return self.__marks

s = Student("Ishan", 90)

print("Name:", s.name)

print("Marks:", s.get_marks())

s.set_marks(95)

print("Updated Marks:", s.get_marks())
